# Database
DATABASE_URL=./data/whisperer.db
DATABASE_TYPE=sqlite

# App
PORT=3000
APP_PREFIX=api

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRATION=7d

# OpenAI (AI Build — optional, local fallback used when empty)
OPENAI_API_KEY=

# Swagger
SWAGGER_TITLE=Content Whisperer API
SWAGGER_PATH=docs
